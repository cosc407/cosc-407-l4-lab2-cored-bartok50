# What core D's given barrier and alternative are supposed to do.
# Read by tests/run_tests.sh, which is identical in all four cores.

VARIATION=D

# This core's brief names 100 rounds, because one round of the given barrier
# costs a poll interval -- a millisecond on Linux and about sixteen on Windows,
# where the timer granularity is coarser. The checks use the same number.
ROUNDS=100

# ... and the watchdog has to be well clear of 100 rounds x two waits x one
# poll interval, or the checks would report a deadlock on a barrier that is
# merely slow. Distinguishing those two is the student's job in S2.1; it should
# not also be the autograder's.
WATCHDOG=30

ALT_LABEL="the sense-reversing spin barrier: atomics, no lock, no sleep"
ALT_CORRECT=yes

# See core A's expect.env for the list of checks.
#
# The one machine-independent claim in this lab: a barrier whose rounds are
# floored by a sleep is slower than one that is woken, by two orders of
# magnitude on any platform. Everything else about the measurement, including
# the poll-interval sweep, is marked from RESULTS.md.
CORE_CHECK=fixed_faster_than_given
